<?xml version='1.0' encoding='UTF-8' standalone='yes'?>
<MATLABApp schemaVersion='1.0.0' release='R2026b.0' minRelease='R2026b'>
    <UIFigure name='UIFigure'>
        <Color>[0.96 0.97 0.98]</Color>
        <Name>'Flight Sensor Package Demo'</Name>
        <Position>[80 80 1180 720]</Position>
        <Children>
            <GridLayout name='MainGrid'>
                <ColumnSpacing>12</ColumnSpacing>
                <ColumnWidth>{290, '1x'}</ColumnWidth>
                <Padding>[12 12 12 12]</Padding>
                <RowHeight>{'1x'}</RowHeight>
                <Children>
                    <Panel name='ControlPanel'>
                        <FontWeight>'bold'</FontWeight>
                        <Layout>
                            <Column>1</Column>
                            <Row>1</Row>
                        </Layout>
                        <Title>'Workflow'</Title>
                        <Children>
                            <GridLayout name='ControlGrid'>
                                <ColumnWidth>{'1x', 'fit'}</ColumnWidth>
                                <Padding>[14 14 14 14]</Padding>
                                <RowHeight>{'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit', 'fit', '1x'}</RowHeight>
                                <RowSpacing>9</RowSpacing>
                                <Children>
                                    <Label name='TitleLabel'>
                                        <FontSize>18</FontSize>
                                        <FontWeight>'bold'</FontWeight>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>1</Row>
                                        </Layout>
                                        <Text>'Air Speed Virtual Sensor App'</Text>
                                        <WordWrap>'on'</WordWrap>
                                    </Label>
                                    <Button name='RefreshAppButton'>
                                        <ButtonPushedFcn>RefreshAppButtonPushed</ButtonPushedFcn>
                                        <Layout>
                                            <Column>2</Column>
                                            <Row>2</Row>
                                        </Layout>
                                        <Text>'Refresh App'</Text>
                                        <Tooltip>'Refresh package dependency status'</Tooltip>
                                    </Button>
                                    <Label name='FileLabel'>
                                        <Layout>
                                            <Column>1</Column>
                                            <Row>2</Row>
                                        </Layout>
                                        <Text>'File: not loaded'</Text>
                                        <WordWrap>'on'</WordWrap>
                                    </Label>
                                    <Button name='LoadDataButton'>
                                        <ButtonPushedFcn>LoadDataButtonPushed</ButtonPushedFcn>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>5</Row>
                                        </Layout>
                                        <Text>'Load Data'</Text>
                                    </Button>
                                    <Label name='DataFileEditFieldLabel'>
                                        <FontWeight>'bold'</FontWeight>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>3</Row>
                                        </Layout>
                                        <Text>'Data file'</Text>
                                    </Label>
                                    <EditField name='DataFileEditField'>
                                        <Layout>
                                            <Column>1</Column>
                                            <Row>4</Row>
                                        </Layout>
                                        <Value>'FlightData.xlsx'</Value>
                                    </EditField>
                                    <Button name='SelectDataButton'>
                                        <ButtonPushedFcn>SelectDataButtonPushed</ButtonPushedFcn>
                                        <Layout>
                                            <Column>2</Column>
                                            <Row>4</Row>
                                        </Layout>
                                        <Text>'Select File...'</Text>
                                    </Button>
                                    <Button name='PlotDataButton'>
                                        <ButtonPushedFcn>PlotDataButtonPushed</ButtonPushedFcn>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>6</Row>
                                        </Layout>
                                        <Text>'Plot Data'</Text>
                                    </Button>
                                    <Button name='CleanDataButton'>
                                        <ButtonPushedFcn>CleanDataButtonPushed</ButtonPushedFcn>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>7</Row>
                                        </Layout>
                                        <Text>'Clean Data'</Text>
                                    </Button>
                                    <Button name='ExploreDataButton'>
                                        <ButtonPushedFcn>ExploreDataButtonPushed</ButtonPushedFcn>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>8</Row>
                                        </Layout>
                                        <Text>'Explore Data'</Text>
                                    </Button>
                                    <Button name='FitModelButton'>
                                        <ButtonPushedFcn>FitModelButtonPushed</ButtonPushedFcn>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>9</Row>
                                        </Layout>
                                        <Text>'Fit Virtual Sensor Model'</Text>
                                    </Button>
                                    <Label name='StatusLabel'>
                                        <Layout>
                                            <Column>[1 2]</Column>
                                            <Row>10</Row>
                                        </Layout>
                                        <Text>'Loading local sample data...'</Text>
                                        <WordWrap>'on'</WordWrap>
                                    </Label>
                                </Children>
                            </GridLayout>
                        </Children>
                    </Panel>
                    <TabGroup name='ResultsTabGroup'>
                        <Layout>
                            <Column>2</Column>
                            <Row>1</Row>
                        </Layout>
                        <Children>
                            <Tab name='DataTab'>
                                <Title>'Data'</Title>
                                <Children>
                                    <GridLayout name='DataGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[8 8 8 8]</Padding>
                                        <RowHeight>{'1x'}</RowHeight>
                                        <Children>
                                            <Table name='DataTable'>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                            </Table>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='PlotTab'>
                                <Title>'Plot'</Title>
                                <Children>
                                    <GridLayout name='PlotGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[8 8 8 8]</Padding>
                                        <RowHeight>{'1x'}</RowHeight>
                                        <Children>
                                            <UIAxes name='MainAxes'>
                                                <Box>'on'</Box>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                                <XGrid>'on'</XGrid>
                                                <YGrid>'on'</YGrid>
                                            </UIAxes>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                            <Tab name='ChartTab'>
                                <Title>'Explore'</Title>
                            </Tab>
                            <Tab name='ModelTab'>
                                <Title>'Virtual Sensor'</Title>
                                <Children>
                                    <GridLayout name='ModelGrid'>
                                        <ColumnWidth>{'1x'}</ColumnWidth>
                                        <Padding>[8 8 8 8]</Padding>
                                        <RowHeight>{'1x', 'fit'}</RowHeight>
                                        <RowSpacing>8</RowSpacing>
                                        <Children>
                                            <UIAxes name='ModelAxes'>
                                                <Box>'on'</Box>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>1</Row>
                                                </Layout>
                                                <XGrid>'on'</XGrid>
                                                <YGrid>'on'</YGrid>
                                            </UIAxes>
                                            <Label name='ModelSummaryLabel'>
                                                <Layout>
                                                    <Column>1</Column>
                                                    <Row>2</Row>
                                                </Layout>
                                                <Text>'Fit the virtual sensor to compare measured and predicted true airspeed.'</Text>
                                                <WordWrap>'on'</WordWrap>
                                            </Label>
                                        </Children>
                                    </GridLayout>
                                </Children>
                            </Tab>
                        </Children>
                    </TabGroup>
                </Children>
            </GridLayout>
        </Children>
    </UIFigure>
    <RunConfiguration>
        <StartupFcn>startupFcn</StartupFcn>
    </RunConfiguration>
    <AppDetails>
        <Name>FlightSensorApp</Name>
        <Version>1.0</Version>
    </AppDetails>
    <InternalData>
        <AppId>de2ea148-ff2f-f7c2-6ecf-a0deacb6a2b0</AppId>
    </InternalData>
    <!-- Thumbnail is used by file previewers. To change how the thumbnail is captured or stored, use the App Details dialog box in App Designer. -->
    <Thumbnail autoCapture='true'>data:image/jpg;base64,</Thumbnail>
</MATLABApp>
